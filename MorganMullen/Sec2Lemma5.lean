import MorganMullen.Sec2Coordinates

/-!
# Section 2, Lemma 2.3: coordinates by partial resolvents

* (a) inversion formula (`coord_inversion`) and injectivity of the coordinate map,
* (b) Frobenius equivariance of the partial resolvents,
* (c) the coordinates of a system of representatives of the pair orbits give an `F`-linear
  bijection of `E` onto `∏_π X_π`, `|X_π| = q^{|π|}` (`coord_isomorphism`, `finrank_Xorb`,
  `natCard_Xorb`); consequently the coordinates of distinct pair orbits are independent and
  uniformly distributed (`card_coord_mem`).
-/

set_option linter.unusedSectionVars false

namespace MorganMullen

open Module Finset FiniteField Polynomial

section Orbits

variable (q n : ℕ) [NeZero n]

/-- The pair orbits: the equivalence relation generated by `PairRel` (which is already an
equivalence relation, see `eqvGen_pairRel_iff`). -/
def pairSetoid : Setoid (ZMod (Model.nfree q n) × ZMod (Model.pa q n)) :=
  Relation.EqvGen.setoid (Model.PairRel q n)

/-- The set of pair orbits. -/
abbrev PairOrb : Type := Quotient (pairSetoid q n)

variable {q n}

lemma pairStep_iterate (j : ℕ) (π : ZMod (Model.nfree q n) × ZMod (Model.pa q n)) :
    (Model.pairStep q n)^[j] π = ((q : ZMod (Model.nfree q n)) ^ j * π.1, π.2 + j) := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [Function.iterate_succ_apply', ih]
    simp only [Model.pairStep, pow_succ, Nat.cast_succ]
    ext
    · simp only; ring
    · simp only; ring

lemma pairRel_iff {π π' : ZMod (Model.nfree q n) × ZMod (Model.pa q n)} :
    Model.PairRel q n π π' ↔ ∃ j, (Model.pairStep q n)^[j] π = π' := by
  simp only [Model.PairRel, pairStep_iterate]
  constructor
  · rintro ⟨j, h1, h2⟩; exact ⟨j, Prod.ext h1.symm h2.symm⟩
  · rintro ⟨j, rfl⟩; exact ⟨j, rfl, rfl⟩

lemma pairStep_period (hq : IsPrimePow q) :
    ∃ N, 0 < N ∧ ∀ π, (Model.pairStep q n)^[N] π = π := by
  set u := Model.qUnit (n := n) hq
  refine ⟨orderOf u * Model.pa q n, Nat.mul_pos (orderOf_pos u) (Nat.pos_of_ne_zero (NeZero.ne _)),
    fun π => ?_⟩
  rw [pairStep_iterate]
  have h1 : ((q : ZMod (Model.nfree q n))) ^ (orderOf u * Model.pa q n) = 1 := by
    rw [← Model.coe_qUnit hq, ← Units.val_pow_eq_pow_val, pow_mul, pow_orderOf_eq_one, one_pow,
      Units.val_one]
  have h2 : ((orderOf u * Model.pa q n : ℕ) : ZMod (Model.pa q n)) = 0 := by
    rw [Nat.cast_mul, ZMod.natCast_self, mul_zero]
  rw [h1, h2, one_mul, add_zero]

lemma pairRel_symm (hq : IsPrimePow q) {π π' : ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (h : Model.PairRel q n π π') : Model.PairRel q n π' π := by
  obtain ⟨N, hN, hper⟩ := pairStep_period (n := n) hq
  rw [pairRel_iff] at h ⊢
  obtain ⟨j, rfl⟩ := h
  refine ⟨N * j - j, ?_⟩
  rw [← Function.iterate_add_apply, Nat.sub_add_cancel (Nat.le_mul_of_pos_left j hN)]
  induction j with
  | zero => simp
  | succ j ih => rw [Nat.mul_succ, Function.iterate_add_apply, hper, ih]

lemma pairRel_trans {π π' π'' : ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (h : Model.PairRel q n π π') (h' : Model.PairRel q n π' π'') : Model.PairRel q n π π'' := by
  rw [pairRel_iff] at h h' ⊢
  obtain ⟨j, rfl⟩ := h
  obtain ⟨j', rfl⟩ := h'
  exact ⟨j' + j, Function.iterate_add_apply _ _ _ _⟩

lemma eqvGen_pairRel_iff (hq : IsPrimePow q) {π π' : ZMod (Model.nfree q n) × ZMod (Model.pa q n)} :
    Relation.EqvGen (Model.PairRel q n) π π' ↔ Model.PairRel q n π π' := by
  constructor
  · intro h
    induction h with
    | rel _ _ h => exact h
    | refl x => exact ⟨0, by simp, by simp⟩
    | symm _ _ _ ih => exact pairRel_symm hq ih
    | trans _ _ _ _ _ ih1 ih2 => exact pairRel_trans ih1 ih2
  · exact Relation.EqvGen.rel _ _

lemma mk_eq_mk_iff (hq : IsPrimePow q) {π π' : ZMod (Model.nfree q n) × ZMod (Model.pa q n)} :
    (Quotient.mk (pairSetoid q n) π = Quotient.mk (pairSetoid q n) π') ↔ Model.PairRel q n π π' := by
  rw [Quotient.eq]
  exact eqvGen_pairRel_iff hq

open Classical in
lemma sum_card_orbits :
    ∑ ω : PairOrb q n, Fintype.card {π // Quotient.mk (pairSetoid q n) π = ω} = n := by
  classical
  rw [← Fintype.card_sigma, Fintype.card_congr (Equiv.sigmaFiberEquiv _), Fintype.card_prod,
    ZMod.card, ZMod.card, mul_comm, Model.pa_mul_nfree]

open Classical in
/-- The size `|π|` of the pair orbit `π` (here `ω`). -/
noncomputable def orbCard (ω : PairOrb q n) : ℕ :=
  Fintype.card {π // Quotient.mk (pairSetoid q n) π = ω}

open Classical in
/-- `∑_π |π| = n' p^a = n`. -/
lemma sum_orbCard : ∑ ω : PairOrb q n, orbCard ω = n := sum_card_orbits

/-- Every pair is a periodic point of `(i, u) ↦ (q i, u + 1)`. -/
lemma mem_periodicPts_pairStep (hq : IsPrimePow q)
    (r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)) :
    r ∈ Function.periodicPts (Model.pairStep q n) := by
  obtain ⟨N, hN, hper⟩ := pairStep_period (n := n) hq
  exact Function.mk_mem_periodicPts hN (hper r)

/-- The size of a pair orbit is the minimal period of `(i, u) ↦ (q i, u + 1)` at any of its
points. -/
theorem orbCard_eq_pairPeriod (hq : IsPrimePow q) {ω : PairOrb q n}
    {r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)} (hr : Quotient.mk (pairSetoid q n) r = ω) :
    orbCard ω = Model.pairPeriod q n r := by
  classical
  have hs0 : 0 < Model.pairPeriod q n r :=
    Function.minimalPeriod_pos_of_mem_periodicPts (mem_periodicPts_pairStep hq r)
  have hmem : ∀ j, Quotient.mk (pairSetoid q n) ((Model.pairStep q n)^[j] r) = ω := by
    intro j
    rw [← hr, mk_eq_mk_iff hq]
    exact pairRel_symm hq (pairRel_iff.2 ⟨j, rfl⟩)
  let f : Fin (Model.pairPeriod q n r) → {π // Quotient.mk (pairSetoid q n) π = ω} := fun j =>
    ⟨(Model.pairStep q n)^[j] r, hmem j⟩
  have hf : Function.Bijective f := by
    refine ⟨fun j j' h => Fin.ext (Function.iterate_injOn_Iio_minimalPeriod j.2 j'.2
      (congrArg Subtype.val h)), fun π => ?_⟩
    have h1 : Quotient.mk (pairSetoid q n) r = Quotient.mk (pairSetoid q n) π.1 := hr.trans π.2.symm
    rw [mk_eq_mk_iff hq, pairRel_iff] at h1
    obtain ⟨j, hj⟩ := h1
    exact ⟨⟨j % Model.pairPeriod q n r, Nat.mod_lt _ hs0⟩,
      Subtype.ext ((Function.iterate_mod_minimalPeriod_eq).trans hj)⟩
  rw [orbCard, Fintype.card_eq_nat_card, ← Nat.card_eq_of_bijective f hf, Nat.card_eq_fintype_card,
    Fintype.card_fin]

/-- A pair orbit is non-empty: `|π| ≥ 1`. -/
lemma orbCard_pos (ω : PairOrb q n) : 0 < orbCard ω := by
  classical
  unfold orbCard
  exact Fintype.card_pos_iff.2 ⟨⟨ω.out, Quotient.out_eq ω⟩⟩

/-- `|π|` steps of `(i, u) ↦ (q i, u + 1)` return to the starting point of the pair orbit `π`. -/
lemma iterate_orbCard (hq : IsPrimePow q) {ω : PairOrb q n}
    {r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)} (hr : Quotient.mk (pairSetoid q n) r = ω) :
    (Model.pairStep q n)^[orbCard ω] r = r := by
  rw [orbCard_eq_pairPeriod hq hr]
  exact Function.iterate_minimalPeriod

end Orbits

section Setting

variable {F E : Type*} [Field F] [Fintype F] [Field E] [Fintype E] [Algebra F E]
variable {Ω : Type*} [Field Ω] [Algebra F Ω] [Algebra E Ω] [IsScalarTower F E Ω]

local notation "q" => Fintype.card F
local notation "n" => Module.finrank F E

lemma sum_zmod_val {M : Type*} [AddCommMonoid M] (m : ℕ) [NeZero m] (f : ℕ → M) :
    ∑ i : ZMod m, f i.val = ∑ k ∈ range m, f k := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, (Nat.succ_pred_eq_of_pos (Nat.pos_of_ne_zero (NeZero.ne m))).symm⟩
  exact Fin.sum_univ_eq_sum_range f (k + 1)

open Classical in
lemma geom_sum_root_of_unity {m : ℕ} (_hm : 0 < m) {x : Ω} (hx : x ^ m = 1) :
    ∑ k ∈ range m, x ^ k = if x = 1 then (m : Ω) else 0 := by
  split_ifs with h
  · simp [h]
  · rw [geom_sum_eq h, hx, sub_self, zero_div]

open Classical in
/-- **Lemma 2.3 (a)**, the inversion formula at `t = 0`:
`n' w = ∑_{η ∈ μ_{n'}} F_η(w)(0)`. -/
theorem coord_inversion_zero {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) (w : E) :
    ∑ i : ZMod (Model.nfree q n), resolvent (F := F) (ζ ^ i.val) 0 w =
      ((Model.nfree q n : ℕ) : Ω) * algebraMap E Ω w := by
  have hq : IsPrimePow q := FiniteField.isPrimePow_card F
  have hn0 : n ≠ 0 := Module.finrank_pos.ne'
  simp_rw [resolvent_apply]
  rw [Finset.sum_comm]
  have hn'pos : 0 < Model.nfree q n := Nat.pos_of_ne_zero (NeZero.ne _)
  -- the inner sums
  have hinner : ∀ t ∈ (range n).filter (fun t : ℕ => (t : ZMod (Model.pa q n)) = 0),
      ∑ i : ZMod (Model.nfree q n), (ζ ^ i.val)⁻¹ ^ t * algebraMap E Ω (((frobeniusAlgHom F E) ^ t) w) =
        if t = 0 then ((Model.nfree q n : ℕ) : Ω) * algebraMap E Ω w else 0 := by
    intro t ht
    rw [Finset.mem_filter, Finset.mem_range, ZMod.natCast_eq_zero_iff] at ht
    rw [← Finset.sum_mul]
    have e : ∀ i : ZMod (Model.nfree q n), (ζ ^ i.val)⁻¹ ^ t = ((ζ ^ t)⁻¹) ^ i.val := by
      intro i; rw [inv_pow, inv_pow, ← pow_mul, ← pow_mul, mul_comm]
    simp_rw [e]
    rw [sum_zmod_val (Model.nfree q n) (fun k => (ζ ^ t)⁻¹ ^ k),
      geom_sum_root_of_unity hn'pos (by rw [inv_pow, ← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one,
        one_pow, inv_one])]
    by_cases h0 : t = 0
    · subst h0; simp
    · rw [ite_eq_right h0]
      have hne : (ζ ^ t)⁻¹ ≠ 1 := by
        rw [Ne, inv_eq_one, hζ.pow_eq_one_iff_dvd]
        intro hdvd
        have : n ∣ t := by
          rw [← Model.pa_mul_nfree q n]
          exact Nat.Coprime.mul_dvd_of_dvd_of_dvd
            ((Model.coprime_chr_nfree hq hn0).pow_left _) ht.2 hdvd
        exact h0 (Nat.eq_zero_of_dvd_of_lt this ht.1)
      rw [ite_eq_right hne, zero_mul]
  rw [Finset.sum_congr rfl hinner, Finset.sum_ite_eq']
  rw [ite_eq_left]
  simp only [Finset.mem_filter, Finset.mem_range, Nat.cast_zero, and_true]
  exact Nat.pos_of_ne_zero hn0

/-- **Lemma 2.3 (a)**, consequence: the coordinate map `w ↦ (F_η(w)(u))_{η,u}` is injective. -/
theorem coord_injective {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) :
    Function.Injective fun (w : E) (π : ZMod (Model.nfree q n) × ZMod (Model.pa q n)) =>
      resolvent (F := F) (ζ ^ π.1.val) π.2 w := by
  intro w w' h
  have h1 := coord_inversion_zero hζ w
  have h2 := coord_inversion_zero hζ w'
  have h3 : ∑ i : ZMod (Model.nfree q n), resolvent (F := F) (ζ ^ i.val) 0 w =
      ∑ i : ZMod (Model.nfree q n), resolvent (F := F) (ζ ^ i.val) 0 w' :=
    Finset.sum_congr rfl fun i _ => congrFun h (i, 0)
  rw [h1, h2] at h3
  have hn0 : n ≠ 0 := Module.finrank_pos.ne'
  have hc : ((Model.nfree q n : ℕ) : Ω) ≠ 0 := by
    have := dfree_cast_ne_zero (F := F) (Ω := Ω) hn0
    rwa [show Model.dfree q n = Model.nfree q n from rfl] at this
  exact (algebraMap E Ω).injective (mul_left_cancel₀ hc h3)

lemma sum_range_shift_periodic {M : Type*} [AddCommGroup M] (f : ℕ → M) {N : ℕ}
    (hf : ∀ t, f (t + N) = f t) (j : ℕ) : ∑ t ∈ range N, f (t + j) = ∑ t ∈ range N, f t := by
  induction j with
  | zero => simp
  | succ j ih =>
    have h1 := Finset.sum_range_succ (fun t => f (t + j)) N
    have h2 := Finset.sum_range_succ' (fun t => f (t + j)) N
    have h3 : f (N + j) = f (0 + j) := by rw [add_comm N j, hf, zero_add]
    rw [← ih]
    simp only [← add_assoc, add_right_comm _ 1 j] at h2 ⊢
    rw [h3] at h1
    have := h1.symm.trans h2
    simp only [add_comm _ 1] at this ⊢
    exact (add_right_cancel this).symm

lemma frobE_pow_finrank : (frobeniusAlgHom F E) ^ n = 1 := frob_pow_finrank

/-- **Lemma 2.3 (b)**: `F_{η^{q^j}}(w)(u + j) = η^{-j q^j} F_η(w)(u)^{q^j}` for
`η ∈ μ_{n'}`. -/
theorem resolvent_frobenius {η : Ω} (hη : η ^ Model.nfree q n = 1) (w : E)
    (u : ZMod (Model.pa q n)) (j : ℕ) :
    resolvent (F := F) (η ^ q ^ j) (u + (j : ZMod (Model.pa q n))) w =
      (η ^ (j * q ^ j))⁻¹ * resolvent (F := F) η u w ^ q ^ j := by
  classical
  obtain ⟨k, hp, hk⟩ := FiniteField.card F (ringChar F)
  have : Fact (ringChar F).Prime := ⟨hp⟩
  have := charP_Ω (F := F) (Ω := Ω)
  have hQ : q ^ j = ringChar F ^ ((k : ℕ) * j) := by rw [hk, pow_mul]
  have hηn : η ^ n = 1 := by
    obtain ⟨c, hc⟩ := Model.nfree_dvd q n
    rw [hc, pow_mul, hη, one_pow]
  have hpa : Model.pa q n ∣ n := Model.pa_dvd q n
  set η' := η ^ q ^ j with hη'
  have hη'n : η' ^ n = 1 := by rw [hη', ← pow_mul, mul_comm, pow_mul, hηn, one_pow]
  -- the summands as functions on `ℕ`
  set f : ℕ → Ω := fun t => if (t : ZMod (Model.pa q n)) = u + j then
      η'⁻¹ ^ t * algebraMap E Ω (((frobeniusAlgHom F E) ^ t) w) else 0 with hf
  have hfper : ∀ t, f (t + n) = f t := by
    intro t
    have e1 : ((t + n : ℕ) : ZMod (Model.pa q n)) = (t : ZMod (Model.pa q n)) := by
      rw [Nat.cast_add, (ZMod.natCast_eq_zero_iff n _).2 hpa, add_zero]
    simp only [hf, e1, pow_add, inv_pow, hη'n, mul_one, frobE_pow_finrank]
  rw [resolvent_apply, resolvent_apply, Finset.sum_filter, Finset.sum_filter]
  change ∑ t ∈ range n, f t = _
  rw [← sum_range_shift_periodic f hfper j, hQ, sum_pow_char_pow, ← hQ, Finset.mul_sum]
  refine Finset.sum_congr rfl fun t _ => ?_
  have e2 : ((t + j : ℕ) : ZMod (Model.pa q n)) = u + j ↔ (t : ZMod (Model.pa q n)) = u := by
    rw [Nat.cast_add, add_left_inj]
  simp only [hf, e2]
  split_ifs with h
  · rw [mul_pow, ← map_pow, inv_pow, inv_pow, inv_pow, ← pow_mul, ← pow_mul]
    have e3 : (((frobeniusAlgHom F E) ^ t) w) ^ q ^ j = ((frobeniusAlgHom F E) ^ (t + j)) w := by
      rw [frob_pow_apply, frob_pow_apply, ← pow_mul, ← pow_add]
    rw [e3, mul_add, pow_add, mul_inv, mul_comm (q ^ j) t, mul_comm (q ^ j) j]
    ring
  · rw [zero_pow (pow_pos Fintype.card_pos j).ne', mul_zero]

/-- The shift identity behind Lemma 2.3 (a): `F_η(σ^t w)(0) = η^t F_η(w)(t mod p^a)` for `η^n = 1`. -/
lemma resolvent_zero_frob_pow {η : Ω} (hη : η ^ n = 1) (w : E) (t : ℕ) :
    resolvent (F := F) η 0 (((frobeniusAlgHom F E) ^ t) w) =
      η ^ t * resolvent (F := F) η (t : ZMod (Model.pa q n)) w := by
  classical
  have hpa : Model.pa q n ∣ n := Model.pa_dvd q n
  set f : ℕ → Ω := fun s => if (s : ZMod (Model.pa q n)) = t then
      η⁻¹ ^ s * algebraMap E Ω (((frobeniusAlgHom F E) ^ s) w) else 0 with hf
  have hfper : ∀ s, f (s + n) = f s := by
    intro s
    have e1 : ((s + n : ℕ) : ZMod (Model.pa q n)) = (s : ZMod (Model.pa q n)) := by
      rw [Nat.cast_add, (ZMod.natCast_eq_zero_iff n _).2 hpa, add_zero]
    simp only [hf, e1, pow_add, inv_pow, hη, mul_one, frobE_pow_finrank]
  rw [resolvent_apply, resolvent_apply, Finset.sum_filter, Finset.sum_filter]
  change _ = η ^ t * ∑ s ∈ range n, f s
  rw [← sum_range_shift_periodic f hfper t, Finset.mul_sum]
  refine Finset.sum_congr rfl fun s _ => ?_
  have e2 : ((s + t : ℕ) : ZMod (Model.pa q n)) = t ↔ (s : ZMod (Model.pa q n)) = 0 := by
    rw [Nat.cast_add, add_eq_right]
  simp only [hf, e2]
  split_ifs with h
  · have hη0 : η ≠ 0 := by
      rintro rfl
      rw [zero_pow (NeZero.ne n)] at hη
      exact zero_ne_one hη
    have e3 : ((frobeniusAlgHom F E) ^ s) (((frobeniusAlgHom F E) ^ t) w) =
        ((frobeniusAlgHom F E) ^ (s + t)) w := by
      rw [pow_add, AlgHom.mul_apply]
    rw [e3, ← mul_assoc]
    congr 1
    rw [pow_add, ← mul_assoc, mul_comm (η ^ t), mul_assoc, ← mul_pow, mul_inv_cancel₀ hη0, one_pow,
      mul_one]
  · rw [mul_zero]

/-- **Lemma 2.3 (a)**: the inversion formula
`σ^t(w) = (1/n') ∑_{η ∈ μ_{n'}} η^t F_η(w)(t mod p^a)` for every `t` (`η = ζ^i`; as `σ^n = 1`,
`t ∈ ℕ` covers all `t ∈ ℤ/n`), stated as `∑_{η ∈ μ_{n'}} η^t F_η(w)(t mod p^a) = n' σ^t(w)`. -/
theorem coord_inversion {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) (w : E) (t : ℕ) :
    ∑ i : ZMod (Model.nfree q n),
        (ζ ^ i.val) ^ t * resolvent (F := F) (ζ ^ i.val) (t : ZMod (Model.pa q n)) w =
      ((Model.nfree q n : ℕ) : Ω) * algebraMap E Ω (((frobeniusAlgHom F E) ^ t) w) := by
  rw [← coord_inversion_zero hζ]
  refine Finset.sum_congr rfl fun i _ => (resolvent_zero_frob_pow ?_ w t).symm
  rw [← pow_mul, mul_comm, pow_mul, (hζ.pow_eq_one_iff_dvd n).2 (Model.nfree_dvd q n), one_pow]

/-- **Lemma 2.3 (a)**, with the factor `1/n'`:
`σ^t(w) = (1/n') ∑_{η ∈ μ_{n'}} η^t F_η(w)(t mod p^a)`. -/
theorem coord_inversion_inv {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) (w : E) (t : ℕ) :
    algebraMap E Ω (((frobeniusAlgHom F E) ^ t) w) =
      ((Model.nfree q n : ℕ) : Ω)⁻¹ * ∑ i : ZMod (Model.nfree q n),
        (ζ ^ i.val) ^ t * resolvent (F := F) (ζ ^ i.val) (t : ZMod (Model.pa q n)) w := by
  have hn0 : n ≠ 0 := Module.finrank_pos.ne'
  have hc : ((Model.nfree q n : ℕ) : Ω) ≠ 0 := by
    have := dfree_cast_ne_zero (F := F) (Ω := Ω) hn0
    rwa [show Model.dfree q n = Model.nfree q n from rfl] at this
  rw [coord_inversion hζ w t, inv_mul_cancel_left₀ hc]

/-! ### Lemma 2.3 (c): the coordinates of distinct pair orbits are independent -/


open Classical in
/-- The coordinates of `w` on the pair orbit `ω`. -/
noncomputable def coordOrb (ζ : Ω) (w : E) (ω : PairOrb q n) :
    {π // Quotient.mk (pairSetoid q n) π = ω} → Ω :=
  fun π => resolvent (F := F) (ζ ^ π.1.1.val) π.1.2 w

/-- A root-count bound: `|{x : x = c x^{Q}}| ≤ Q` for `c ≠ 0`, `Q ≥ 2`. -/
lemma card_le_of_frob_fixed {X : Finset Ω} {c : Ω} (hc : c ≠ 0) {Q : ℕ} (hQ : 2 ≤ Q)
    (hX : ∀ x ∈ X, x = c * x ^ Q) : X.card ≤ Q := by
  classical
  set P : Polynomial Ω := Polynomial.C c * Polynomial.X ^ Q - Polynomial.X
  have hdeg : P.natDegree = Q := by
    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt] <;>
      rw [Polynomial.natDegree_C_mul_X_pow _ _ hc]
    simp; omega
  have hP0 : P ≠ 0 := by
    intro h; rw [h, Polynomial.natDegree_zero] at hdeg; omega
  calc X.card ≤ P.roots.toFinset.card := by
        apply Finset.card_le_card
        intro x hx
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hP0, Polynomial.IsRoot, Polynomial.eval_sub,
          Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X, ← hX x hx,
          sub_self]
    _ ≤ Multiset.card P.roots := Multiset.toFinset_card_le _
    _ ≤ P.natDegree := Polynomial.card_roots' P
    _ = Q := hdeg

open Classical in
/-- **Lemma 2.3 (c)**, dimension count: the coordinates on a pair orbit of size `s` take at most
`q^s` values. -/
theorem card_range_coordOrb_le {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) (ω : PairOrb q n) :
    Fintype.card (Set.range fun w : E => coordOrb (F := F) ζ w ω) ≤
      q ^ Fintype.card {π // Quotient.mk (pairSetoid q n) π = ω} := by
  have hq : IsPrimePow q := FiniteField.isPrimePow_card F
  set r := ω.out with hr
  have hrω : Quotient.mk (pairSetoid q n) r = ω := Quotient.out_eq ω
  obtain ⟨N, hN, hper⟩ := @pairStep_period (Fintype.card F) (finrank F E) _ hq
  have hrper : r ∈ Function.periodicPts (Model.pairStep q n) :=
    Function.mk_mem_periodicPts hN (hper r)
  set s := Function.minimalPeriod (Model.pairStep q n) r with hs
  have hs0 : 0 < s := Function.minimalPeriod_pos_of_mem_periodicPts hrper
  have hsr : (Model.pairStep q n)^[s] r = r := Function.iterate_minimalPeriod
  have hmem : ∀ j, Quotient.mk (pairSetoid q n) ((Model.pairStep q n)^[j] r) = ω := by
    intro j
    rw [← hrω, mk_eq_mk_iff hq]
    exact pairRel_symm hq (pairRel_iff.2 ⟨j, rfl⟩)
  have hscard : s ≤ Fintype.card {π // Quotient.mk (pairSetoid q n) π = ω} := by
    let f : Fin s → {π // Quotient.mk (pairSetoid q n) π = ω} := fun j =>
      ⟨(Model.pairStep q n)^[j] r, hmem j⟩
    have hf : Function.Injective f := by
      intro j j' h
      have h' : (Model.pairStep q n)^[(j : ℕ)] r = (Model.pairStep q n)^[(j' : ℕ)] r :=
        congrArg Subtype.val h
      exact Fin.ext (Function.iterate_injOn_Iio_minimalPeriod j.2 j'.2 h')
    simpa using Fintype.card_le_of_injective f hf
  set η := ζ ^ r.1.val with hηdef
  have hη : η ^ Model.nfree q n = 1 := by
    rw [hηdef, ← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
  have hη0 : η ≠ 0 := by
    intro h; rw [h, zero_pow (NeZero.ne _)] at hη; exact zero_ne_one hη
  have hclass : ∀ π : {π // Quotient.mk (pairSetoid q n) π = ω},
      ∃ j, (Model.pairStep q n)^[j] r = π.1 := by
    intro π
    have : Quotient.mk (pairSetoid q n) r = Quotient.mk (pairSetoid q n) π.1 := hrω.trans π.2.symm
    rwa [mk_eq_mk_iff hq, pairRel_iff] at this
  have hcoord : ∀ (w : E) (j : ℕ),
      resolvent (F := F) (ζ ^ ((Model.pairStep q n)^[j] r).1.val) ((Model.pairStep q n)^[j] r).2 w =
        (η ^ (j * q ^ j))⁻¹ * resolvent (F := F) η r.2 w ^ q ^ j := by
    intro w j
    rw [pairStep_iterate]
    have e : ζ ^ (((q : ZMod (Model.nfree q n)) ^ j * r.1).val) = η ^ q ^ j := by
      rw [hηdef, ← pow_mul]
      apply pow_eq_pow_of_cast_eq hζ.pow_eq_one
      push_cast
      rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      ring
    simp only
    rw [e]
    exact resolvent_frobenius hη w r.2 j
  let ev : (Set.range fun w : E => coordOrb (F := F) ζ w ω) → Ω := fun y => y.1 ⟨r, hrω⟩
  have hev_inj : Function.Injective ev := by
    rintro ⟨y, w, rfl⟩ ⟨y', w', rfl⟩ h
    simp only [ev, coordOrb] at h
    apply Subtype.ext
    funext π
    obtain ⟨j, hj⟩ := hclass π
    simp only [coordOrb]
    rw [← hj, hcoord w j, hcoord w' j, h]
  have hX : ∀ x ∈ Finset.univ.image ev, x = (η ^ (s * q ^ s))⁻¹ * x ^ q ^ s := by
    intro x hx
    obtain ⟨⟨y, w, rfl⟩, -, rfl⟩ := Finset.mem_image.1 hx
    have := hcoord w s
    rw [hsr] at this
    exact this
  have hc : (η ^ (s * q ^ s))⁻¹ ≠ 0 := inv_ne_zero (pow_ne_zero _ hη0)
  have hq2 : 2 ≤ q := hq.two_le
  have hQ2 : 2 ≤ q ^ s := le_trans hq2 (Nat.le_self_pow hs0.ne' q)
  calc Fintype.card (Set.range fun w : E => coordOrb (F := F) ζ w ω)
      = (Finset.univ.image ev).card := (Finset.card_image_of_injective _ hev_inj).symm
    _ ≤ q ^ s := card_le_of_frob_fixed hc hQ2 hX
    _ ≤ q ^ Fintype.card {π // Quotient.mk (pairSetoid q n) π = ω} :=
        Nat.pow_le_pow_right (by omega) hscard

open Classical in
/-- **Lemma 2.3 (c)**: the coordinate map `w ↦ (coordinates on ω)_ω` is a bijection of `E` onto the
product over the pair orbits of the sets of values taken on each orbit. -/
theorem coord_product {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) :
    Function.Bijective fun (w : E) (ω : PairOrb q n) =>
      (⟨coordOrb (F := F) ζ w ω, w, rfl⟩ : Set.range fun w : E => coordOrb (F := F) ζ w ω) := by
  set f := fun (w : E) (ω : PairOrb q n) =>
    (⟨coordOrb (F := F) ζ w ω, w, rfl⟩ : Set.range fun w : E => coordOrb (F := F) ζ w ω) with hf
  have hinj : Function.Injective f := by
    intro w w' h
    apply coord_injective hζ
    funext π
    have := congrArg (fun g => (g (Quotient.mk (pairSetoid q n) π)).1 ⟨π, rfl⟩) h
    simpa [f, coordOrb] using this
  refine (Fintype.bijective_iff_injective_and_card f).2 ⟨hinj, ?_⟩
  apply le_antisymm (Fintype.card_le_of_injective f hinj)
  rw [Fintype.card_pi]
  calc ∏ ω : PairOrb q n, Fintype.card (Set.range fun w : E => coordOrb (F := F) ζ w ω)
      ≤ ∏ ω : PairOrb q n, q ^ Fintype.card {π // Quotient.mk (pairSetoid q n) π = ω} :=
        Finset.prod_le_prod fun ω _ => card_range_coordOrb_le hζ ω
    _ = q ^ ∑ ω : PairOrb q n, Fintype.card {π // Quotient.mk (pairSetoid q n) π = ω} :=
        Finset.prod_pow_eq_pow_sum _ _ _
    _ = Fintype.card E := by rw [sum_card_orbits]; exact (Module.card_eq_pow_finrank (K := F) (V := E)).symm

/-! ### Lemma 2.3 (c) in the form of the paper -/

/-- `x ↦ x^{q^s}` is additive on `Ω` (characteristic `p`). -/
lemma add_pow_card_pow (x y : Ω) (s : ℕ) : (x + y) ^ q ^ s = x ^ q ^ s + y ^ q ^ s := by
  obtain ⟨k, hp, hk⟩ := FiniteField.card F (ringChar F)
  have : Fact (ringChar F).Prime := ⟨hp⟩
  have := charP_Ω (F := F) (Ω := Ω)
  rw [hk, ← pow_mul]
  exact add_pow_char_pow x y _ _

/-- The space `X_π = {x ∈ Ω : x = η_π^{-s} x^{q^s}}`, `s = |π|`, attached to the pair orbit
`π = ω` with representative `r = (i, u)`, `η_π = ζ^i`; it is an `F`-subspace of `Ω`
(`x ↦ x^{q^s}` is additive and fixes `F`). -/
noncomputable def Xorb (ζ : Ω) (ω : PairOrb q n)
    (r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)) : Submodule F Ω where
  carrier := {x | x = ((ζ ^ r.1.val) ^ orbCard ω)⁻¹ * x ^ q ^ orbCard ω}
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_ofPred_eq] at hx hy ⊢
    rw [add_pow_card_pow, mul_add, ← hx, ← hy]
  zero_mem' := by
    simp only [Set.mem_ofPred_eq]
    rw [zero_pow (pow_ne_zero _ Fintype.card_ne_zero), mul_zero]
  smul_mem' := by
    intro a x hx
    simp only [Set.mem_ofPred_eq, Algebra.smul_def] at hx ⊢
    rw [mul_pow, ← map_pow, FiniteField.pow_card_pow, mul_left_comm, ← hx]

/-- Membership in `X_π`: `x ∈ X_π ↔ x = η_π^{-s} x^{q^s}`, `s = |π|`. -/
lemma mem_Xorb {ζ : Ω} {ω : PairOrb q n} {r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    {x : Ω} :
    x ∈ Xorb (F := F) (E := E) ζ ω r ↔ x = ((ζ ^ r.1.val) ^ orbCard ω)⁻¹ * x ^ q ^ orbCard ω :=
  Iff.rfl

/-- `X_π` is finite with at most `q^{|π|}` elements. -/
lemma finite_Xorb_and_natCard_le {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    (ω : PairOrb q n) (r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)) :
    Finite (Xorb (F := F) (E := E) ζ ω r) ∧
      Nat.card (Xorb (F := F) (E := E) ζ ω r) ≤ q ^ orbCard ω := by
  have hq : IsPrimePow q := FiniteField.isPrimePow_card F
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (NeZero.ne _)
  have hc : ((ζ ^ r.1.val) ^ orbCard ω)⁻¹ ≠ 0 := inv_ne_zero (pow_ne_zero _ (pow_ne_zero _ hζ0))
  have hQ2 : 2 ≤ q ^ orbCard ω :=
    le_trans hq.two_le (Nat.le_self_pow (orbCard_pos ω).ne' q)
  set S : Set Ω := (Xorb (F := F) (E := E) ζ ω r : Set Ω)
  have hfin : S.Finite := by
    by_contra hinf
    obtain ⟨t, hts, htc⟩ := Set.Infinite.exists_subset_card_eq hinf (q ^ orbCard ω + 1)
    have := card_le_of_frob_fixed hc hQ2 fun x hx => mem_Xorb.1 (hts hx)
    omega
  refine ⟨Set.finite_coe_iff.2 hfin, ?_⟩
  change Nat.card S ≤ _
  rw [Nat.card_eq_card_finite_toFinset hfin]
  exact card_le_of_frob_fixed hc hQ2 fun x hx => mem_Xorb.1 ((Set.Finite.mem_toFinset hfin).1 hx)

/-- Lemma 2.3 (b) along a pair orbit: the coordinate at `(q^j i, u + j)` is
`η^{-j q^j} F_η(w)(u)^{q^j}`, `η = ζ^i`. -/
lemma resolvent_pairStep_iterate {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) (w : E)
    (r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)) (j : ℕ) :
    resolvent (F := F) (ζ ^ ((Model.pairStep q n)^[j] r).1.val) ((Model.pairStep q n)^[j] r).2 w =
      ((ζ ^ r.1.val) ^ (j * q ^ j))⁻¹ * resolvent (F := F) (ζ ^ r.1.val) r.2 w ^ q ^ j := by
  have hη : (ζ ^ r.1.val) ^ Model.nfree q n = 1 := by
    rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
  rw [pairStep_iterate]
  have e : ζ ^ (((q : ZMod (Model.nfree q n)) ^ j * r.1).val) = (ζ ^ r.1.val) ^ q ^ j := by
    rw [← pow_mul]
    apply pow_eq_pow_of_cast_eq hζ.pow_eq_one
    push_cast
    rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    ring
  rw [e]
  exact resolvent_frobenius hη w r.2 j

/-- The representative coordinate `F_{η_π}(w)(u_π)` lies in `X_π`. -/
lemma resolvent_mem_Xorb {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) {ω : PairOrb q n}
    {r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)} (hr : Quotient.mk (pairSetoid q n) r = ω)
    (w : E) : resolvent (F := F) (ζ ^ r.1.val) r.2 w ∈ Xorb (F := F) (E := E) ζ ω r := by
  have hq : IsPrimePow q := FiniteField.isPrimePow_card F
  have hs := iterate_orbCard hq hr
  have h := resolvent_pairStep_iterate hζ w r (orbCard ω)
  rw [hs] at h
  have h1 : (q : ZMod (Model.nfree q n)) ^ orbCard ω * r.1 = r.1 := by
    have := congrArg Prod.fst hs
    rwa [pairStep_iterate] at this
  have hfix : (ζ ^ r.1.val) ^ q ^ orbCard ω = ζ ^ r.1.val := by
    rw [← pow_mul]
    apply pow_eq_pow_of_cast_eq hζ.pow_eq_one
    push_cast
    rw [ZMod.natCast_zmod_val, mul_comm]
    exact h1
  rw [mul_comm (orbCard ω), pow_mul, hfix] at h
  exact mem_Xorb.2 h

/-- The coordinate map of Lemma 2.3 (c), `w ↦ (F_{η_π}(w)(u_π))_π`, for a choice `rep` of
representatives `(η_π, u_π) = (ζ^i, u)` of the pair orbits, as an `F`-linear map into `∏_π X_π`. -/
noncomputable def coordRep {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    {rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (hrep : ∀ ω, Quotient.mk (pairSetoid q n) (rep ω) = ω) :
    E →ₗ[F] ((ω : PairOrb q n) → Xorb (F := F) (E := E) ζ ω (rep ω)) :=
  LinearMap.pi fun ω => (resolvent (F := F) (ζ ^ (rep ω).1.val) (rep ω).2).codRestrict _
    (resolvent_mem_Xorb hζ (hrep ω))

/-- The `π`-component of `coordRep` is the representative coordinate `F_{η_π}(w)(u_π)`. -/
@[simp] lemma coordRep_apply {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    {rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (hrep : ∀ ω, Quotient.mk (pairSetoid q n) (rep ω) = ω) (w : E) (ω : PairOrb q n) :
    (coordRep hζ hrep w ω : Ω) = resolvent (F := F) (ζ ^ (rep ω).1.val) (rep ω).2 w :=
  rfl

/-- By Lemma 2.3 (a), (b) the representative coordinates determine `w`. -/
lemma coordRep_injective {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    {rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (hrep : ∀ ω, Quotient.mk (pairSetoid q n) (rep ω) = ω) :
    Function.Injective (coordRep hζ hrep) := by
  have hq : IsPrimePow q := FiniteField.isPrimePow_card F
  intro w w' h
  apply coord_injective hζ
  funext π
  have h1 : Quotient.mk (pairSetoid q n) (rep (Quotient.mk (pairSetoid q n) π)) =
      Quotient.mk (pairSetoid q n) π := hrep _
  rw [mk_eq_mk_iff hq, pairRel_iff] at h1
  obtain ⟨j, hj⟩ := h1
  have hω := congrArg (fun g => (g (Quotient.mk (pairSetoid q n) π) : Ω)) h
  simp only [coordRep_apply] at hω
  simp only
  rw [← hj, resolvent_pairStep_iterate hζ w, resolvent_pairStep_iterate hζ w', hω]

open Classical in
/-- `|E| = q^n = ∏_π q^{|π|}`. -/
lemma natCard_eq_prod_orbCard : Nat.card E = ∏ ω : PairOrb q n, q ^ orbCard ω := by
  rw [Finset.prod_pow_eq_pow_sum, sum_orbCard, Nat.card_eq_fintype_card,
    Module.card_eq_pow_finrank (K := F) (V := E)]

/-- The map `w ↦ (F_{η_π}(w)(u_π))_π` is a bijection of `E` onto `∏_π X_π` (injectivity and
`|∏_π X_π| ≤ ∏_π q^{|π|} = |E|`). -/
theorem coordRep_bijective {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    {rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (hrep : ∀ ω, Quotient.mk (pairSetoid q n) (rep ω) = ω) :
    Function.Bijective (coordRep hζ hrep) := by
  classical
  have : ∀ ω, Finite (Xorb (F := F) (E := E) ζ ω (rep ω)) := fun ω =>
    (finite_Xorb_and_natCard_le hζ ω (rep ω)).1
  refine (coordRep_injective hζ hrep).bijective_of_nat_card_le ?_
  rw [Nat.card_pi, natCard_eq_prod_orbCard (F := F) (E := E)]
  exact Finset.prod_le_prod fun ω _ => (finite_Xorb_and_natCard_le hζ ω (rep ω)).2

/-- The `F`-linear isomorphism `E ≅ ∏_π X_π`, `w ↦ (F_{η_π}(w)(u_π))_π`, of Lemma 2.3 (c). -/
noncomputable def coordEquiv {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    {rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (hrep : ∀ ω, Quotient.mk (pairSetoid q n) (rep ω) = ω) :
    E ≃ₗ[F] ((ω : PairOrb q n) → Xorb (F := F) (E := E) ζ ω (rep ω)) :=
  LinearEquiv.ofBijective (coordRep hζ hrep) (coordRep_bijective hζ hrep)

/-- The `π`-component of `coordEquiv` is the representative coordinate `F_{η_π}(w)(u_π)`. -/
@[simp] lemma coordEquiv_apply {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    {rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (hrep : ∀ ω, Quotient.mk (pairSetoid q n) (rep ω) = ω) (w : E) (ω : PairOrb q n) :
    (coordEquiv hζ hrep w ω : Ω) = resolvent (F := F) (ζ ^ (rep ω).1.val) (rep ω).2 w :=
  rfl

/-- `dim_F X_π = |π|` for the chosen representatives: `dim X_π ≤ |π|` for every `π`, and
`∑_π dim X_π = dim E = n = ∑_π |π|`. -/
lemma finrank_Xorb_rep {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    {rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (hrep : ∀ ω, Quotient.mk (pairSetoid q n) (rep ω) = ω) (ω : PairOrb q n) :
    finrank F (Xorb (F := F) (E := E) ζ ω (rep ω)) = orbCard ω := by
  classical
  have hq : IsPrimePow q := FiniteField.isPrimePow_card F
  have : ∀ ω, Finite (Xorb (F := F) (E := E) ζ ω (rep ω)) := fun ω =>
    (finite_Xorb_and_natCard_le hζ ω (rep ω)).1
  have : ∀ ω, Module.Finite F (Xorb (F := F) (E := E) ζ ω (rep ω)) := fun _ =>
    Module.Finite.of_finite
  have hle : ∀ ω' ∈ (univ : Finset (PairOrb q n)),
      finrank F (Xorb (F := F) (E := E) ζ ω' (rep ω')) ≤ orbCard ω' := by
    intro ω' _
    have h := (finite_Xorb_and_natCard_le hζ ω' (rep ω')).2
    rw [Module.natCard_eq_pow_finrank (K := F), Nat.card_eq_fintype_card] at h
    exact (Nat.pow_le_pow_iff_right hq.one_lt).1 h
  have hsum : ∑ ω' : PairOrb q n, finrank F (Xorb (F := F) (E := E) ζ ω' (rep ω')) =
      ∑ ω' : PairOrb q n, orbCard ω' := by
    rw [sum_orbCard, ← Module.finrank_pi_fintype F, ← (coordEquiv hζ hrep).finrank_eq]
  exact (Finset.sum_eq_sum_iff_of_le hle).1 hsum ω (mem_univ ω)

/-- `X_π` has dimension `|π|` over `F`, for any representative of `π`. -/
theorem finrank_Xorb {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) {ω : PairOrb q n}
    {r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)} (hr : Quotient.mk (pairSetoid q n) r = ω) :
    finrank F (Xorb (F := F) (E := E) ζ ω r) = orbCard ω := by
  classical
  let rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n) := fun ω' =>
    if ω' = ω then r else ω'.out
  have hrep : ∀ ω', Quotient.mk (pairSetoid q n) (rep ω') = ω' := by
    intro ω'
    change Quotient.mk (pairSetoid q n) (if ω' = ω then r else ω'.out) = ω'
    split_ifs with h
    · rw [hr, h]
    · exact Quotient.out_eq ω'
  have h := finrank_Xorb_rep hζ hrep ω
  have hrω : rep ω = r := ite_eq_left rfl
  rwa [hrω] at h

/-- `X_π` has exactly `q^{|π|}` elements. -/
theorem natCard_Xorb {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n)) {ω : PairOrb q n}
    {r : ZMod (Model.nfree q n) × ZMod (Model.pa q n)} (hr : Quotient.mk (pairSetoid q n) r = ω) :
    Nat.card (Xorb (F := F) (E := E) ζ ω r) = q ^ orbCard ω := by
  have : Finite (Xorb (F := F) (E := E) ζ ω r) := (finite_Xorb_and_natCard_le hζ ω r).1
  have : Module.Finite F (Xorb (F := F) (E := E) ζ ω r) := Module.Finite.of_finite
  rw [Module.natCard_eq_pow_finrank (K := F), Nat.card_eq_fintype_card, finrank_Xorb hζ hr]

/-- **Lemma 2.3 (c)** (paper form): let `rep` choose a representative `(η_π, u_π)` of every pair
orbit `π` (`η_π = ζ^i` for `rep π = (i, u_π)`). Then `w ↦ (F_{η_π}(w)(u_π))_π` is an `F`-linear
isomorphism of `E` onto `∏_π X_π`, where `X_π = {x ∈ Ω : x = η_π^{-s} x^{q^s}}`, `s = |π|`, is an
`F`-subspace of `Ω` of dimension `|π|`. -/
theorem coord_isomorphism {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    {rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (hrep : ∀ ω, Quotient.mk (pairSetoid q n) (rep ω) = ω) :
    ∃ e : E ≃ₗ[F] ((ω : PairOrb q n) → Xorb (F := F) (E := E) ζ ω (rep ω)),
      (∀ (w : E) (ω : PairOrb q n),
        (e w ω : Ω) = resolvent (F := F) (ζ ^ (rep ω).1.val) (rep ω).2 w) ∧
      ∀ ω, finrank F (Xorb (F := F) (E := E) ζ ω (rep ω)) = orbCard ω :=
  ⟨coordEquiv hζ hrep, coordEquiv_apply hζ hrep, finrank_Xorb_rep hζ hrep⟩

open Classical in
/-- **Lemma 2.3 (c)**, consequence (counting form): for subsets `A_π ⊆ X_π`, the number of `w ∈ E`
with `F_{η_π}(w)(u_π) ∈ A_π` for every pair orbit `π` is `∏_π |A_π|`. Since `|E| = ∏_π |X_π|`,
this says that for `w` uniformly distributed in `E` the coordinates of distinct pair orbits are
independent and uniformly distributed in the `X_π`. -/
theorem card_coord_mem {ζ : Ω} (hζ : IsPrimitiveRoot ζ (Model.nfree q n))
    {rep : PairOrb q n → ZMod (Model.nfree q n) × ZMod (Model.pa q n)}
    (hrep : ∀ ω, Quotient.mk (pairSetoid q n) (rep ω) = ω) (A : PairOrb q n → Finset Ω)
    (hA : ∀ ω, ∀ x ∈ A ω, x ∈ Xorb (F := F) (E := E) ζ ω (rep ω)) :
    (univ.filter fun w : E =>
        ∀ ω, resolvent (F := F) (ζ ^ (rep ω).1.val) (rep ω).2 w ∈ A ω).card =
      ∏ ω, (A ω).card := by
  set e := coordEquiv hζ hrep
  let T : (ω : PairOrb q n) → Finset (Xorb (F := F) (E := E) ζ ω (rep ω)) := fun ω =>
    (A ω).subtype (· ∈ Xorb (F := F) (E := E) ζ ω (rep ω))
  have hT : ∀ ω, (T ω).card = (A ω).card := by
    intro ω
    simp only [T, Finset.card_subtype]
    rw [Finset.filter_true_of_mem (hA ω)]
  have hmemT : ∀ y : (ω : PairOrb q n) → Xorb (F := F) (E := E) ζ ω (rep ω),
      y ∈ Fintype.piFinset T ↔ ∀ ω, (y ω : Ω) ∈ A ω := by
    intro y
    simp only [Fintype.mem_piFinset, T, Finset.mem_subtype]
  rw [← Finset.prod_congr rfl fun ω _ => hT ω, ← Fintype.card_piFinset]
  refine Finset.card_nbij' (fun w => e w) (fun y => e.symm y) ?_ ?_ ?_ ?_
  · intro w hw
    simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq] at hw
    rw [Finset.mem_coe, hmemT]
    intro ω
    rw [coordEquiv_apply]
    exact hw ω
  · intro y hy
    rw [Finset.mem_coe, hmemT] at hy
    simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq]
    intro ω
    rw [← coordEquiv_apply hζ hrep, LinearEquiv.apply_symm_apply]
    exact hy ω
  · intro w _
    exact e.symm_apply_apply w
  · intro y _
    exact e.apply_symm_apply y

end Setting

end MorganMullen
